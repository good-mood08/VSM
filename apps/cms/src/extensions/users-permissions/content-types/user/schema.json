{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "user_achivments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-achivment.user-achivment",
      "mappedBy": "users_permissions_user"
    },
    "user_competitions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-competition.user-competition",
      "mappedBy": "users_permissions_user"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "notifications_users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notifications-user.notifications-user",
      "mappedBy": "users_permissions_user"
    },
    "isInspector": {
      "type": "boolean"
    },
    "user_scenarios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-scenario.user-scenario",
      "mappedBy": "users_permissions_user"
    },
    "user_scenarios_examinee": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-scenario.user-scenario",
      "mappedBy": "examinee"
    },
    "rating": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::rating.rating",
      "mappedBy": "users_permissions_user"
    },
    "user_datasses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-datass.user-datass",
      "mappedBy": "users_permissions_user"
    }
  }
}
